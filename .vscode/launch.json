{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: chat.py + BlobService",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/chat.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "redirectOutput": true,
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "stopOnEntry": false
    }
  ]
}
